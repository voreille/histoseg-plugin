# syntax=docker/dockerfile:1

FROM python:3.10.21-slim-trixie AS base

ENV PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libopenslide0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.5 \
    /uv /usr/local/bin/uv

WORKDIR /app

# Install third-party dependencies first for better Docker caching.
COPY pyproject.toml uv.lock /app/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
        --locked \
        --no-default-groups \
        --extra cpu \
        --no-install-project

COPY src/ /app/src/
COPY config/ /app/config/


# Development image: includes dev and test dependency groups.
FROM base AS development

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
        --locked \
        --extra cpu

CMD ["uvicorn", "histoseg_plugin.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]


# Production is the final/default target.
FROM base AS production

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync \
        --locked \
        --no-default-groups \
        --extra cpu

CMD ["uvicorn", "histoseg_plugin.api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]